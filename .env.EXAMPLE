# Granada Gold Mine — fill in with Granada's own accounts (never Coniagas's).
# Each integration stays off until its keys are set; see SETUP.md.

# CONTENTFUL_ACCESS_TOKEN: a Content Delivery API token (or a Preview token for draft review), never the management token.
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=
CONTENTFUL_ENVIRONMENT=master
# Draft review: CONTENTFUL_HOST=preview.contentful.com with a Content Preview API token.
# The eventual live site must use the default cdn.contentful.com and a Delivery token.
CONTENTFUL_HOST=

# Optional public origin for canonical URLs, language links and sitemaps.
# Defaults to Cloudflare's CF_PAGES_URL, then https://granadagoldmine.com.
SITE_URL=
# Review deployments emit noindex headers/meta and robots.txt Disallow: /.
# Also enabled automatically when CONTENTFUL_HOST=preview.contentful.com.
SITE_REVIEW_MODE=false

# Algolia stays off until both switches are 'true' (indexing writes to the index on every build).
GATSBY_ALGOLIA_APP_ID=
GATSBY_ALGOLIA_SEARCH_KEY=
ALGOLIA_ADMIN_KEY=
ALGOLIA_INDEXING_ENABLED=false
GATSBY_ALGOLIA_SEARCH_ENABLED=false

GATSBY_FORMSPREE_CONTACT_ID=
GATSBY_FORMSPREE_SUBSCRIBE_ID=

# Optional: preview a Contentful export locally (e.g. Codex's pilot-import.json) instead of the
# placeholder news. Ignored once CONTENTFUL_SPACE_ID and CONTENTFUL_ACCESS_TOKEN are set.
NEWS_FIXTURE=
